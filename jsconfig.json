{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "allowJs": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.js",
    "app/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "node_modules/**"
  ]
}
